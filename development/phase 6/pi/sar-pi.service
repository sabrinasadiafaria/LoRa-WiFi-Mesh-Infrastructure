# SAR Command Centre - run the Pi mesh node + dashboard on boot.
#
#   sudo cp sar-pi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sar-pi
#   journalctl -u sar-pi -f            # live logs
#
# Adjust User= and the two paths to match where you cloned the repo.

[Unit]
Description=SAR LoRa Mesh Command Centre
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/LoRa-WiFi-Mesh-Infrastructure/development/phase 5/pi
ExecStart=/home/pi/LoRa-WiFi-Mesh-Infrastructure/development/phase 5/pi/venv/bin/python3 main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
