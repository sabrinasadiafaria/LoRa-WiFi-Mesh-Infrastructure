<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10151b">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAR GPS Provider"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for permissions..."
            android:textColor="#aeb8c2"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lat: --\nLon: --\nAcc: --"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:background="#18212b"
            android:padding="16dp" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Packets: 0\nLast: --\nBattery: --%"
            android:textColor="#aeb8c2"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:background="#18212b"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="START GPS SHARING"
            android:backgroundTint="#28a745"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:padding="16dp" />

        <Button
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOS (HOLD TO ACTIVATE)"
            android:backgroundTint="#DC3545"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:padding="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESET MESSAGES"
            android:textColor="#aeb8c2"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnNeedHelp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEED HELP"
                android:backgroundTint="#FFC107"
                android:textColor="#000000"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnInjured"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INJURED"
                android:backgroundTint="#FD7E14"
                android:textColor="#ffffff"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnFoundVictim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FOUND VICTIM"
                android:backgroundTint="#17A2B8"
                android:textColor="#ffffff"
                android:layout_marginEnd="4dp" />
            <Button
                android:id="@+id/btnSafe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SAFE"
                android:backgroundTint="#28A745"
                android:textColor="#ffffff"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
